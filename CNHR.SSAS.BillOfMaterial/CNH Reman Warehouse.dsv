          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="dbo_Fact_BOM" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:QueryDefinition="SELECT fb.RootPartId, fb.SiteRef, fb.PartId, fb.Lvl, fb.Sort, fb.SortPath, fb.Name, fb.ItemDescription, fb.Stocked, fb.Source, fb.Phantom, fb.Job, fb.PLAN_CODE, fb.Oper, fb.Seq, fb.PullID, fb.OptGrp, fb.OptID, fb.Equiv, fb.OrigQty, fb.Repl, fb.NetQty, fb.ExtQuantity, fb.ExtRepl, fb.RunHrs, &#xD;&#xA;             fb.UpdatedBy, fb.RecordDate, fb.LoadBatchID, fb.ComboKey, IM.Uf_CNH_EngineeringFamilyCode, IM.Uf_CNH_EngineeringSubFamilyCode, DI.ProductCodeDescr, IM2.cur_u_cost, fb.ExtQuantity * IM2.cur_u_cost AS ExtCost&#xD;&#xA;FROM   Fact_BOM AS fb LEFT OUTER JOIN&#xD;&#xA;             CNHReman_Warehouse_CSI.dbo.Dim_Item AS DI ON fb.RootPartId = DI.Item AND fb.SiteRef = DI.Site LEFT OUTER JOIN&#xD;&#xA;             CNHReman_Stagearea_CSI.dbo.item_mst AS IM ON IM.item = fb.RootPartId AND IM.site_ref = fb.SiteRef LEFT OUTER JOIN&#xD;&#xA;             CNHReman_Stagearea_CSI.dbo.item_mst AS IM2 ON IM2.item = fb.PartId AND IM2.site_ref = fb.SiteRef" msprop:FriendlyName="Fact_BOM" msprop:TableType="View" msprop:DbTableName="Fact_BOM">
